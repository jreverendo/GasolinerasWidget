<?xml version="1.0" encoding="utf-8"?>
<com.tuapp.gasolineraswidget.CapsuleDragLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/floating_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_card"
        android:elevation="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/floating_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_header"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/btn_network"
                style="@style/FloatingChipButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/widget_toggle_red_todas" />

            <TextView
                android:id="@+id/btn_criterio"
                style="@style/FloatingChipButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:text="@string/floating_criterio_barata" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_gps"
                style="@style/FloatingIconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/floating_gps_description"
                android:src="@drawable/ic_gps_location"
                android:tint="@color/floating_icon_tint" />

            <ImageButton
                android:id="@+id/btn_json"
                style="@style/FloatingIconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/floating_json_description"
                android:src="@drawable/ic_refresh_prices"
                android:tint="@color/floating_icon_tint" />

            <ImageButton
                android:id="@+id/btn_coffee"
                style="@style/FloatingIconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/floating_coffee_description"
                android:src="@drawable/ic_coffee"
                android:tint="@color/floating_icon_tint" />

            <ImageButton
                android:id="@+id/btn_close"
                style="@style/FloatingIconButton.Close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/floating_close_description"
                android:src="@drawable/ic_close_capsule"
                android:tint="@color/floating_close_icon" />
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/floating_divider" />

        <!--
            Tarjeta de donaciones: se muestra dentro de la capsula, encima de
            la lista, y se oculta al cerrar el QR. No altera el arrastre.
        -->
        <LinearLayout
            android:id="@+id/floating_kofi_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_floating_row"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/floating_kofi_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/kofi_qr_capsule_text"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/floating_kofi_qr"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/kofi_qr_image_description"
                android:scaleType="fitCenter"
                android:src="@drawable/qr_kofi" />

            <TextView
                android:id="@+id/floating_kofi_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/kofi_url_short"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/floating_kofi_close"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="128dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/kofi_qr_close"
                android:textColor="@color/floating_chip_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/floating_protagonist_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/floating_protagonist_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_floating_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/floating_nombre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/floating_combustible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_toggle_red"
                        android:maxLines="1"
                        android:paddingStart="5dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="5dp"
                        android:paddingBottom="1dp"
                        android:textColor="@color/widget_toggle_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/floating_distancia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/floating_acceso"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/floating_acceso_description"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_acceso_barras_3"
                        android:tint="@color/acceso_neutra" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/floating_precio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_precio_negro"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="9dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/precio_texto_claro"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/floating_ahorro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:textColor="@color/deposito_neutro"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@color/floating_divider" />

            <TextView
                android:id="@+id/btn_expand"
                android:layout_width="48dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_floating_expand"
                android:contentDescription="@string/floating_expand_description"
                android:gravity="center"
                android:text="@string/floating_expand_symbol"
                android:textColor="@color/floating_button_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/floating_extra_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</com.tuapp.gasolineraswidget.CapsuleDragLayout>
