<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/config_background"
    android:orientation="vertical"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/config_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/main_subtitle"
                android:textColor="@color/config_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/main_overlay_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/main_overlay_missing"
                android:textColor="@color/deposito_sobrecoste"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/main_location_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/main_location_missing"
                android:textColor="@color/deposito_sobrecoste"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/main_floating_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/main_floating_inactive"
                android:textColor="@color/config_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/main_floating_config_title"
                android:textColor="@color/config_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/main_floating_config_hint"
                android:textColor="@color/config_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/main_floating_fuel_title"
                android:textColor="@color/config_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/floating_fuel_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/floating_fuel_g95"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="44dp"
                    android:text="@string/fuel_gasolina_95"
                    android:textColor="@color/config_text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/floating_fuel_g98"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/fuel_gasolina_98"
                    android:textColor="@color/config_text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/floating_fuel_goa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/fuel_gasoleo_a"
                    android:textColor="@color/config_text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/floating_fuel_gop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/fuel_gasoleo_premium"
                    android:textColor="@color/config_text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/floating_fuel_glp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/fuel_glp"
                    android:textColor="@color/config_text_primary"
                    android:textSize="15sp" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/main_floating_deposit_title"
                android:textColor="@color/config_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_floating_litros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/main_floating_deposit_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="6"
                android:minHeight="48dp"
                android:selectAllOnFocus="true"
                android:textColor="@color/config_text_primary"
                android:textColorHint="@color/config_text_secondary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/button_save_floating_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/config_button"
                android:minHeight="52dp"
                android:text="@string/main_floating_save"
                android:textAllCaps="false"
                android:textColor="@color/config_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/main_floating_config_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/config_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/main_nav_title"
                android:textColor="@color/config_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/main_nav_hint"
                android:textColor="@color/config_text_secondary"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/main_nav_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/main_nav_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/nav_option_auto"
                    android:textColor="@color/config_text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/main_nav_maps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/nav_nombre_google_maps"
                    android:textColor="@color/config_text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/main_nav_waze"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/nav_nombre_waze"
                    android:textColor="@color/config_text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/main_nav_sygic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/nav_nombre_sygic"
                    android:textColor="@color/config_text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/main_nav_preguntar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/nav_option_preguntar"
                    android:textColor="@color/config_text_primary"
                    android:textSize="15sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/main_nav_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/config_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/main_nav_usage_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/config_button_secondary"
                android:minHeight="48dp"
                android:text="@string/main_nav_usage_button"
                android:textAllCaps="false"
                android:textColor="@color/config_text_primary"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/button_floating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/config_button"
                android:minHeight="52dp"
                android:text="@string/floating_activate_button"
                android:textAllCaps="false"
                android:textColor="@color/config_text_primary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/button_stop_floating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/config_button_secondary"
                android:minHeight="52dp"
                android:text="@string/main_button_stop"
                android:textAllCaps="false"
                android:textColor="@color/config_text_primary"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/main_help"
                android:textColor="@color/config_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/floating_location_hint"
                android:textColor="@color/widget_text_muted"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
