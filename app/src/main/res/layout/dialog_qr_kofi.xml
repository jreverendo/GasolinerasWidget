<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_qr_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_config_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kofi_section_title"
        android:textColor="@color/config_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/kofi_qr_short_text"
        android:textColor="@color/config_text_secondary"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/dialog_qr_image"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:contentDescription="@string/kofi_qr_image_description"
        android:scaleType="fitCenter"
        android:src="@drawable/qr_kofi" />

    <TextView
        android:id="@+id/dialog_qr_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/kofi_url_short"
        android:textColor="@color/config_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/dialog_qr_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/config_button"
        android:minHeight="44dp"
        android:text="@string/kofi_dialog_close"
        android:textAllCaps="false"
        android:textColor="@color/config_text_primary"
        android:textSize="15sp" />
</LinearLayout>
