<?xml version="1.0" encoding="utf-8"?>
<!-- Cierre de la capsula en modo ciudad: verde suave. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/floating_pressed">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/floating_close_city_bg" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/floating_close_city_stroke" />
        </shape>
    </item>
</ripple>
